{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/shopify-sync.js": {
      "maxDuration": 60
    },
    "api/analytics.js": {
      "maxDuration": 60
    },
    "api/odoo.js": {
      "maxDuration": 60
    },
    "api/shopify.js": {
      "maxDuration": 60
    },
    "api/meta.js": {
      "maxDuration": 60
    }
  },
  "crons": [
