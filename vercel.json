{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/shopify-sync.js": {
      "maxDuration": 60
    },
    "api/analytics.js": {
      "maxDuration": 60
    },
    "api/odoo.js": {
      "maxDuration": 60
    },
    "api/shopify.js": {
      "maxDuration": 60
    },
    "api/meta.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/shopify-sync",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}